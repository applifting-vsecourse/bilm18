// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum QuackMood {
  happy
  sad
  angry
  silly

  @@map("quack_mood")
}

// A row is either a live quack or a tombstone: a quack deleted while it had
// replies (docs/adr/0001). The tombstone keeps its place in the thread and
// nothing else — no text, author, mood or poll. The migration's CHECK
// constraint quack_tombstone_check enforces the two shapes.
model Quack {
  id        String     @id @default(cuid())
  // NULL only on a tombstone.
  text      String?    @db.Text
  // Optional: quacks posted without a mood (and every quack from before
  // moods existed) stay null. Always null on a tombstone.
  mood      QuackMood?
  // NULL only on a tombstone: a deleted quack keeps no trace of its author.
  // Cascade stays, but deleting a User is not built yet: whoever builds it
  // must turn the user's replied-to quacks into tombstones first, or the
  // parent foreign key below makes the delete fail (docs/adr/0001).
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  // When the quack was deleted while it had replies. Null on a live quack.
  deletedAt DateTime?

  // The quack this one replies to. Null for a top-level quack.
  // NoAction: the database never deletes a quack that still has replies.
  // (Not Restrict: Postgres checks NoAction at the end of the statement, so
  // a cascade removing a parent together with all its replies passes.)
  parent   Quack?  @relation("QuackReplies", fields: [parentId], references: [id], onDelete: NoAction)
  parentId String?
  replies  Quack[] @relation("QuackReplies")

  // The top-level quack of the thread. Null for a top-level quack itself;
  // CHECK quack_thread_check keeps it set exactly when parentId is.
  // Derivable from the parent chain, stored so a whole thread loads in one
  // query. Written once when the reply is created — quacks never move.
  root          Quack?  @relation("QuackThread", fields: [rootId], references: [id], onDelete: NoAction)
  rootId        String?
  threadReplies Quack[] @relation("QuackThread")

  // A quack with options is a poll — there is no separate poll table.
  // Replies never have one (CreateReplyDto has no field for it).
  pollOptions PollOption[]
  pollVotes   PollVote[]

  @@index([userId])
  @@index([parentId])
  @@index([rootId])
  @@map("quack")
}

model PollOption {
  id       String     @id @default(cuid())
  quack    Quack      @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId  String
  text     String     @db.VarChar(50)
  position Int
  votes    PollVote[]

  @@unique([quackId, position])
  // Target of PollVote's composite foreign key.
  @@unique([id, quackId])
  @@map("poll_option")
}

model PollVote {
  id        String     @id @default(cuid())
  quack     Quack      @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId   String
  // Composite key: the database rejects a vote for an option from another poll.
  option    PollOption @relation(fields: [optionId, quackId], references: [id, quackId], onDelete: Cascade)
  optionId  String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  // One vote per person per poll, enforced by the database.
  @@unique([quackId, userId])
  @@index([optionId])
  @@map("poll_vote")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?   @db.Text
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]
  quacks          Quack[]
  pollVotes       PollVote[]
  role           UserRole  @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)

  // Profile settings — owned by the profile module, not by BetterAuth.
  bio             String?    @db.VarChar(160)
  // Pre-selected in the new-quack form. Null means "no mood".
  defaultMood     QuackMood?

  @@unique([email])
  @@unique([username])
  @@map("user")
}
